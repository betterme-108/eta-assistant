# 英语教学助手 English Teaching Assistant 环境配置
# 复制本文件为 .env 并填入你的 key。.env 只在本机，不要提交到仓库（.gitignore 已忽略）。
# 系统为真实 AI 通道（无 mock 降级）：key 未配置时对应功能会显式报错。
# 本文件列出全部可配置项（含默认值）；等号后带 # 说明的是行内注释，可随意改删。

# ── LLM（OpenAI 兼容直连；deepseek* 前缀自动路由 DeepSeek 官方 API）──
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.1         # 生成随机性（确定性任务保持低值）
LLM_MAX_TOKENS=8192         # 单次回复上限（token）
LLM_TIMEOUT=60              # 单次调用读取等待（秒）
LLM_CONNECT_TIMEOUT=30      # TCP/TLS 连接等待（秒）
LLM_RETRIES=1               # 网络失败重试次数（指数退避）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 非 deepseek 模型的 OpenAI 兼容端点（可选，不设则沿用 DEEPSEEK_*）
# LLM_BASE_URL=
# LLM_API_KEY=

# ── OCR（错题照片 → 文本）──
# 通道可选：mineru（文档解析，推荐）/ paddleocr（异步 jobs）/ qwen_vl_ocr（百炼）
#          / vision（自定义视觉端点）/ dashscope（通义 VL）/ doubao（豆包视觉）
OCR_PROVIDER=mineru
OCR_TIMEOUT=120             # 单次 HTTP 请求超时（秒）
OCR_POLL_INTERVAL=3         # 任务轮询间隔（秒，paddleocr/mineru 轮询用）
OCR_POLL_MAX=100            # 轮询次数上限（超过报解析超时）
OCR_RETRIES=3               # mineru 链路抖动整流程重试（退避 2s/4s）
# mineru 通道（v4 批量上传：申请链接 → PUT 上传 → 轮询 → ZIP 提取 full.md）
# Token 申请：https://mineru.net/apiManage/token（有效期 14 天，过期请更换）
# MINERU_BASE_URL=https://mineru.net
# MINERU_TOKEN=
# MINERU_MODEL_VERSION=vlm
# paddleocr 通道（备用）
# PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr
# PADDLEOCR_TOKEN=
# PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# 通用视觉通道（vision：完全自定义 OpenAI 兼容端点）
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=qwen-vl-plus
# 快捷通道（dashscope / doubao：填 key 即用官方端点；端点可改，如国际版）
# DASHSCOPE_API_KEY=
# DASHSCOPE_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DOUBAO_API_KEY=
# DOUBAO_MODEL=doubao-1.5-vision-pro-32k
# DOUBAO_VL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 拍照批改解析（试卷照片 → 题目/作答/参考答案）──
# 主路 agent：火山智能体会话（联网问答Agent chat/completion），多模态照片直读
# 整页结构化解析；凭据未配置/调用失败时自动降级 OCR 转录路。设 ocr 强制纯 OCR。
# PHOTO_PARSE_PROVIDER=agent
# 智能体会话凭据（联网问答Agent 控制台创建智能体后获得）
# AGENT_CHAT_BOT_ID=
# API Key 接入（推荐：Bearer 免签名）：火山控制台「API Key」的 Secret
# AGENT_CHAT_API_KEY_SECRET=
# AK/SK 接入（备选：火山 TOP 网关 v4 签名；未填 API Key Secret 时启用）
# AGENT_CHAT_ACCESS_KEY_ID=
# AGENT_CHAT_SECRET_ACCESS_KEY=
# AGENT_CHAT_TIMEOUT=180          # 单次 HTTP 超时（秒，整页 JSON 生成耗时较长）
# AGENT_CHAT_API_URL=https://open.feedcoopapi.com/agent_api/agent/chat/completion
# AGENT_CHAT_AKSK_URL=https://mercury.volcengineapi.com?Action=ChatCompletion&Version=2026-01-01
# AGENT_CHAT_REGION=cn-north-1    # AK/SK 签名凭证范围（region/service）
# AGENT_CHAT_SERVICE=ask_echo
#
# 转录降级路（agent 未配置/失败时才走）：不设则沿用 OCR_PROVIDER
#   qwen_vl_ocr  百炼 qwen-vl-ocr（复用 DASHSCOPE_API_KEY；面向试卷/手写场景，
#                附带行坐标）
#   dual         mineru + paddleocr 双转录互补（快通道为主、慢通道补漏，
#                融合由解析 AI 完成；任一通道失败自动降级单转录）
# DOC_OCR_PROVIDER=dual
# QWEN_VL_OCR_MODEL=qwen-vl-ocr

# ── 数据库（默认 runtime/db/eta.db；兼容旧名 XIAOYING_DB / ERROR_RADAR_DB / ERROR_ATLAS_DB）──
# ETA_DB=runtime/db/eta.db

# ── 日志 ──
# LOG_LEVEL=INFO            # 终端显示级别（DEBUG/INFO/WARNING/ERROR）
# LOG_FILE_LEVEL=DEBUG      # 文件日志级别（默认 DEBUG 最全，便于问题定位）
# LOG_DIR=runtime/logs      # 日志目录（默认项目根下 runtime/logs/）
# LOG_KEEP_DAYS=14          # 按天轮转保留天数，过期自动清理

# ── AI 运行留痕（查运行效果用）──
# 每次 LLM/OCR/批改API 调用的输入输出细节落盘为
# runtime/logs/eta-trace-当天日期.jsonl（一行一调用，JSON 格式）；
# 图片等超长 base64 只记长度，密钥不落盘；与日志同目录（runtime/logs/），
# 可直接拷贝给技术人员排查。默认开启，设 0 关闭。
# TRACE_ENABLED=1
# TRACE_KEEP_DAYS=14        # 留痕文件保留天数，过期自动清理
