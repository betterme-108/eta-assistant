#!/bin/bash
# ============================================================
# 英语教学助手 English Teaching Assistant · 双击启动（macOS）
# 双击本文件即可在终端中启动服务；关闭该终端窗口即停止服务
# 核心逻辑与 ./start.sh 完全一致
#
# 依赖安装位置：项目依赖全部装在项目目录内的独立虚拟环境 .venv/
# （不写入系统路径）；只有电脑上没有 Python 时才会安装一份 Python 运行时
# ============================================================
cd "$(dirname "$0")"
exec ./start.sh
